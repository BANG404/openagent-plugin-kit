{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "openagent-plugin-template-theme",
  "version": "1.0.0",
  "description": "Theme template",
  "license": "MIT",
  "extensions": {
    "openagent": {
      "type": "theme",
      "compatibility": {
        "plugin_protocol": {
          "min": 1,
          "max": 1
        },
        "features": [
          "theme-v1"
        ]
      },
      "theme": {
        "version": 1,
        "tokens": {
          "--app-radius": "20px"
        },
        "light": {
          "--primary": "#663399"
        },
        "dark": {
          "--primary": "#cc99ff"
        }
      },
      "i18n": {
        "supported_locales": [
          "en"
        ],
        "default_locale": "en",
        "translations": {
          "en": {
            "display_name": "Theme template",
            "description": "Theme template"
          }
        }
      }
    }
  }
}
