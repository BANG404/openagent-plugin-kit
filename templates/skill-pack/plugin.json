{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "openagent-plugin-template-skill-pack",
  "version": "1.0.0",
  "description": "Starter template with several Skills that form one capability.",
  "license": "MIT",
  "keywords": [
    "openagent",
    "template",
    "skills"
  ],
  "extensions": {
    "openagent": {
      "capabilities": [
        "skills"
      ],
      "i18n": {
        "supported_locales": [
          "en"
        ],
        "default_locale": "en",
        "translations": {
          "en": {
            "display_name": "openagent-plugin-template-skill-pack",
            "description": "Starter template with several Skills that form one capability."
          }
        }
      }
    }
  }
}
