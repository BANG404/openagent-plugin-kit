{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "openagent-plugin-template-full-kit",
  "version": "1.1.0",
  "description": "Reference template containing every Agent Plugin component OpenAgent supports.",
  "license": "MIT",
  "keywords": [
    "openagent",
    "template",
    "reference"
  ],
  "extensions": {
    "openagent": {
      "compatibility": {"plugin_protocol": {"min": 1, "max": 1}},
      "capabilities": [
        "skills",
        "mcp",
        "commands",
        "sidebar",
        "automation"
      ],
      "message_policies": [
        {
          "tag": "notice",
          "user_visible": true,
          "model_visible": false
        }
      ],
      "commands": [
        {
          "id": "describe",
          "label": "Describe package",
          "description": "Ask the model to summarize this plugin's components",
          "argument": "none",
          "command": "bin/describe.cmd",
          "timeout_secs": 15
        }
      ],
      "sidebar": [
        {
          "id": "reference-panel",
          "title": "Reference panel",
          "entry": "ui/panel.html",
          "scope": "workspace",
          "icon": "panel",
          "capabilities": [
            "workspace",
            "locale",
            "theme"
          ]
        }
      ],
      "automation": [
        {
          "id": "after-tool",
          "event": "after_tool",
          "matcher": "^(apply_patch|exec_command)$",
          "command": "hooks/after-tool.cmd",
          "timeout_secs": 15
        }
      ],
      "i18n": {
        "supported_locales": [
          "en"
        ],
        "default_locale": "en",
        "translations": {
          "en": {
            "display_name": "openagent-plugin-template-full-kit",
            "description": "Reference template containing every Agent Plugin component OpenAgent supports.",
            "commands.describe.label": "Describe package",
            "commands.describe.description": "Ask the model to summarize this plugin's components",
            "sidebar.reference-panel.title": "Reference panel"
          }
        }
      },
      "mcp_tool_mode": "direct"
    }
  }
}
