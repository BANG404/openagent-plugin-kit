{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "openagent-plugin-template-daemon",
  "version": "1.0.2",
  "description": "Reference package for a long-lived OpenAgent capability daemon.",
  "license": "MIT",
  "extensions": {
    "openagent": {
      "category": "development",
      "compatibility": {"plugin_protocol": {"min": 1, "max": 1}},
      "capabilities": [
        "daemon"
      ],
      "daemon": {
        "command": "bin/daemon.mjs",
        "args": [
          "--stdio"
        ],
        "transport": "stdio",
        "capabilities": [
          "example"
        ]
      },
      "i18n": {
        "supported_locales": [
          "en"
        ],
        "default_locale": "en",
        "translations": {
          "en": {
            "display_name": "openagent-plugin-template-daemon",
            "description": "Reference package for a long-lived OpenAgent capability daemon."
          }
        }
      }
    }
  }
}
