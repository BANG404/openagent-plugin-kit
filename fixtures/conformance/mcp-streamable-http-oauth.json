{
  "description": "a Streamable HTTP server may declare discovery hints for OAuth",
  "mcp": {
    "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
    "mcpServers": {
      "remote": {
        "type": "streamable-http",
        "url": "https://example.test/mcp",
        "oauth_resource": "https://example.test/",
        "oauth_authorization_server": "https://auth.example.test",
        "oauth_client_id": "openagent",
        "oauth_scope": "tools.read"
      }
    }
  },
  "expect": {
    "valid": true,
    "components": { "mcpServers": 1 }
  }
}
