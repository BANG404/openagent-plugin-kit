{
  "description": "a PLUGIN_DATA subdirectory is accepted even though it does not exist yet",
  "mcp": {
    "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
    "mcpServers": {
      "server": {
        "type": "stdio",
        "command": "node",
        "args": ["server.js"],
        "cwd": "${PLUGIN_DATA}/cache"
      }
    }
  },
  "expect": {
    "valid": true,
    "components": { "mcpServers": 1 }
  }
}
