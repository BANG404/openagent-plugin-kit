{
  "description": "a header value carrying a newline is rejected rather than smuggled into a request",
  "mcp": {
    "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
    "mcpServers": {
      "remote": {
        "type": "streamable-http",
        "url": "https://example.test/mcp",
        "headers": { "X-Token": "a\nb" }
      }
    }
  },
  "expect": {
    "valid": false,
    "diagnostics": [
      { "level": "warning", "contains": "headers contain an invalid value for 'X-Token'" }
    ],
    "components": { "mcpServers": 0 }
  }
}
