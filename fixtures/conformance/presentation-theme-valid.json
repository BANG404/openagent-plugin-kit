{
  "description": "presentation type and declarative theme contract",
  "openagent": {
    "type": "theme",
    "compatibility": {
      "plugin_protocol": {
        "min": 1,
        "max": 1
      },
      "features": [
        "theme-v1"
      ]
    },
    "theme": {
      "version": 1,
      "tokens": {
        "--app-radius": "20px"
      },
      "light": {
        "--primary": "#663399"
      },
      "dark": {
        "--primary": "#cc99ff"
      }
    }
  },
  "expect": {
    "valid": true,
    "clean": true
  }
}
