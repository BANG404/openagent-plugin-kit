{
  "description": "package font declaration is bounded and feature gated",
  "openagent": {
    "type": "theme",
    "compatibility": {
      "plugin_protocol": {
        "min": 1,
        "max": 1
      },
      "features": [
        "theme-v1",
        "theme-fonts-v1"
      ]
    },
    "theme": {
      "version": 1,
      "tokens": {
        "--font-sans": "Probe, sans-serif"
      },
      "fonts": [
        {
          "family": "Probe",
          "entry": "fonts/probe.woff2",
          "weight": "900 100"
        }
      ]
    }
  },
  "files": {
    "fonts/probe.woff2": "wOF2synthetic"
  },
  "expect": {
    "valid": false
  }
}
