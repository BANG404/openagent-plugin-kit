{
  "description": "a header value above ASCII is accepted, because the loader's field-value rule allows it",
  "mcp": {
    "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
    "mcpServers": {
      "remote": {
        "type": "streamable-http",
        "url": "https://example.test/mcp",
        "headers": { "X-Locale": "café 日本語" }
      }
    }
  },
  "expect": {
    "valid": true,
    "clean": true,
    "components": { "mcpServers": 1 }
  }
