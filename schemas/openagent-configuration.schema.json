{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenAgent plugin configuration version 1",
  "description": "The containing manifest must require configuration-v1 in compatibility.features. Runtime validates unique keys/bindings, reserved environment names and named HTTP servers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "fields"],
  "properties": {
    "version": {"const": 1},
    "fields": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["key", "label", "type"],
        "properties": {
          "key": {"type":"string","pattern":"^[a-z0-9]+(?:[-_][a-z0-9]+)*$","maxLength":64},
          "label": {"type":"string","minLength":1,"maxLength":256},
          "description": {"type":"string","maxLength":2048},
          "type": {"enum":["string","boolean","integer","enum"]},
          "required": {"type":"boolean","default":false},
          "secret": {"type":"boolean","default":false},
          "default": {"type":["string","boolean","integer"]},
          "options": {"type":"array","items":{"type":"string","minLength":1,"maxLength":1024}},
          "minimum": {"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},
          "maximum": {"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},
          "env": {"type":"string","pattern":"^[A-Z][A-Z0-9_]{0,127}$"},
          "mcp": {"type":"object","additionalProperties":false,"required":["server","property"],"properties":{"server":{"type":"string","minLength":1},"property":{"enum":["oauth_client_id","oauth_scope","bearer_token"]}}}
        },
        "allOf": [
          {"if":{"properties":{"secret":{"const":true}},"required":["secret"]},"then":{"properties":{"type":{"const":"string"}},"not":{"required":["default"]}}},
          {"if":{"properties":{"type":{"const":"enum"}}},"then":{"required":["options"],"properties":{"options":{"minItems":1,"maxItems":64}}}},
          {"if":{"required":["mcp"]},"then":{"properties":{"type":{"const":"string"}},"not":{"required":["env"]}}}
        ]
      }
    }
  }
}
